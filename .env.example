# Copy to .env. MinIO runs separately: cd ../storage && docker compose up -d

DATA_DIR=/data
# Used by host-side tools only; docker-compose overrides internal endpoint.
STORAGE_ENDPOINT=http://127.0.0.1:9000
# Host in presigned URLs — must be reachable from WordPress (public IP or hostname).
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=visatop-translations
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=changeme
STORAGE_PREFIX=blog-translations
STORAGE_REGION=us-east-1
PRESIGN_TTL_SECONDS=900
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
MAX_CONCURRENCY=6
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=changeme-long-random-string
JOB_RETENTION_DAYS=90
PROMPT_PATH=/app/prompt-blogs.md
